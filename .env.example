# Supabase (pgvector for knowledge base)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key

# OpenAI API key (used for embeddings locally; also store as Tower secret for chat)
OPENAI_API_KEY=sk-...

# Tower chat model (OpenAI model routed through Tower's LLM abstraction)
TOWER_CHAT_MODEL=gpt-4o-mini

# Embedding model (OpenAI)
EMBEDDING_MODEL=text-embedding-3-small

# Evaluation threshold
CONFIDENCE_THRESHOLD=0.6

# Email (mock for now)
ESCALATION_EMAIL_FROM=concierge@checkmate.ai
